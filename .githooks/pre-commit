#!/bin/sh
# Tracked pre-commit entry point. core.hooksPath is converged by bootstrap from
# .claude/bootstrap.json; contributors can also configure it manually.

set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)

run_python() {
    if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
        "$REPO_ROOT/.venv/bin/python" "$@"
    elif [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then
        "$REPO_ROOT/.venv/Scripts/python.exe" "$@"
    elif command -v python3 >/dev/null 2>&1; then
        python3 "$@"
    elif command -v python >/dev/null 2>&1; then
        python "$@"
    elif command -v py >/dev/null 2>&1; then
        py -3 "$@"
    else
        echo "pre-commit: Python 3 is required to run the public-repo guard." >&2
        return 1
    fi
}

run_python "$REPO_ROOT/scripts/precommit_guard.py"

# core.hooksPath REPLACES .git/hooks, so this hook must keep running the repo's
# established version/drift chain -- pre-commit-version-check.sh documents its
# own install as .git/hooks/pre-commit, and that install stops firing once
# hooksPath is set. Chaining it here preserves those checks rather than
# silently disabling them.
#
# The dependency gating now lives INSIDE that script, per check, because only
# one of its five checks needs a provisioned dependency (pyyaml) and the other
# four are stdlib-only. Gating here meant one check's dependency disabled all of
# them -- on precisely the unprovisioned clones least likely to be correct
# already. It also probed with THIS interpreter and then ran the checks under
# `uv run`, a different resolution that can sync a different environment or fail
# where the probe passed; the script now resolves its own interpreters and says
# so when it skips something. The public-repo guard above is dependency-free,
# always runs, and is the only check here that gates commits rather than
# publishes.
"$REPO_ROOT/scripts/pre-commit-version-check.sh"
