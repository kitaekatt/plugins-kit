  "activations": [
    { "participant": "switch", "from": 195, "to": 635, "type": "backend" },
    { "participant": "current", "from": 230, "to": 298, "type": "cloud" },
    { "participant": "prev", "from": 340, "to": 405, "type": "database" },
    { "participant": "new", "from": 450, "to": 515, "type": "frontend" },
