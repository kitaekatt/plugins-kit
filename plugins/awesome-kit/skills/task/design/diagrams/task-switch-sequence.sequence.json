    { "from": "current", "to": "switch", "y": 290, "label": "prev / none", "variant": "return" },
    { "from": "switch", "to": "prev", "y": 345, "label": "update (capture + rotate)", "variant": "emphasis" },
    { "from": "prev", "to": "switch", "y": 400, "label": "now plain Active", "variant": "return" },
    { "from": "switch", "to": "new", "y": 455, "label": "work (validate + activate)", "variant": "emphasis" },
    { "from": "new", "to": "switch", "y": 510, "label": "valid -> active", "variant": "return" },
    { "from": "switch", "to": "current", "y": 565, "label": "set = new", "variant": "emphasis" },
