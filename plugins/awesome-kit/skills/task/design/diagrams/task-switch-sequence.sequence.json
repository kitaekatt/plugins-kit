  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "switch = update then work",
      "items": [
        "switch reads the single global current pointer",
        "It updates the outgoing task, capturing its state and rotating plan/log",
        "After the update the outgoing task is a plain Active task -- no lingering claim"
      ]
    },
    {
      "dot": "amber",
      "title": "Then work the new one",
      "items": [
        "work runs its full path: validate gate, then set current = new",
        "Only one task is current at a time, globally",
        "See the work sequence diagram for the gate + auto-init detail"
      ]
    },
    {
      "dot": "slate",
      "title": "No current => switch == work",
      "items": [
        "If nothing is current, the read returns none",
        "The update step is skipped entirely",
        "switch then behaves exactly like work on the new task"
      ]
    }
  ]
