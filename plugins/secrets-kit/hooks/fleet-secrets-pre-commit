#!/bin/sh
# secrets-kit-guard-version: 2
#
# Pre-commit guard for a fleet-secrets repo. Refuses any commit that would put
# unencrypted material into history.
#
# This exists because git history is PERMANENT. A plaintext credential pushed
# once cannot be cleanly withdrawn: it survives in the object store, in every
# clone, and in any fork or backup taken meanwhile. Rewriting history does not
# fix it either -- the only real remedy is rotating the leaked credential.
# So the guard is deliberately paranoid, and it is an ALLOWLIST.
#
# Allowlist, not denylist: a denylist has to anticipate every shape a secret
# can take, and loses to the first one it never thought of. This refuses every
# path it does not explicitly recognize, so a new kind of file fails CLOSED --
# the failure mode is an annoyed human, not a leak.
#
# Self-contained on purpose. It is copied into .git/hooks/pre-commit rather
# than sourcing the plugin, because the plugin's cache path contains its
# version and moves on every update -- a hook pointing there would silently
# stop working at the worst possible moment. POSIX sh only, so Git for
# Windows runs it unchanged.
#
# Bypassing this (git commit --no-verify) is not a supported workflow. If a
# legitimate file is being refused, add it to the allowlist here and to the
# canonical copy in secrets-kit, so every clone gets the same rule.

set -u

RED=''
BOLD=''
RESET=''
if [ -t 2 ]; then
    RED=$(printf '\033[31m')
    BOLD=$(printf '\033[1m')
    RESET=$(printf '\033[0m')
fi

fail=0
refused=''

note_refusal() {
    refused="${refused}  - $1
      $2
"
    fail=1
}

# Scratch contains ONLY numeric command statuses, never staged filenames or
# content. POSIX modes do not certify Windows ACL privacy. Git for Windows
# supplies mktemp and the streaming utilities; handled exits remove this
# operation's statuses.
refuse_home() {
    printf '%sfleet-secrets pre-commit guard: REFUSED%s\n%s\n' "$RED" "$RESET" "$1" >&2
    exit 1
}

native_absolute() {
    case "$1" in
        [A-Za-z]:/*|[A-Za-z]:\\*) return 0 ;;
        \\\\[?.]\\*) return 1 ;;
        \\\\*)
            native_tail=${1#??}
            native_server=${native_tail%%\\*}
            native_rest=${native_tail#*\\}
            native_share=${native_rest%%\\*}
            [ -n "$native_server" ] && [ "$native_server" != "$native_tail" ] && [ -n "$native_share" ]
            ;;
        //*)
            native_tail=${1#//}
            native_server=${native_tail%%/*}
            native_rest=${native_tail#*/}
            native_share=${native_rest%%/*}
            [ -n "$native_server" ] && [ "$native_server" != "$native_tail" ] && [ -n "$native_share" ]
            ;;
        *) return 1 ;;
    esac
}

case "${HOME-}" in
    '') refuse_home "HOME must be present and nonempty for index status storage." ;;
    /*) ;;
    *)
        if ! native_absolute "$HOME"; then
            refuse_home "HOME must be an absolute supported user-home path."
        fi
        # Probe the running shell, not an ambient OS/MSYSTEM label. Native
        # drive strings are relative on POSIX and must not create C: trees.
        if ! windows_pwd=$(command pwd -W 2>/dev/null) || ! native_absolute "$windows_pwd"; then
            refuse_home "This shell cannot resolve native Windows HOME; use its slash-absolute Git-shell HOME spelling."
        fi
        ;;
esac
if ! guard_user_home=$(CDPATH= cd -P "$HOME" 2>/dev/null && command pwd -P); then
    refuse_home "HOME is not an existing usable directory for index status storage."
fi
case "$guard_user_home" in
    /*) ;;
    *) refuse_home "HOME could not be normalized to a slash-absolute user home." ;;
esac
status_home="$guard_user_home/.claude/plugins/data/plugins-kit/secrets-kit"
umask 077
if ! mkdir -p "$status_home"; then
    refuse_home "Cannot create the named secrets-kit status home."
fi
if ! scratch=$(mktemp -d "$status_home/.guard-status.XXXXXX"); then
    printf '%sfleet-secrets pre-commit guard: REFUSED%s\nCannot create index status scratch space.\n' "$RED" "$RESET" >&2
    exit 1
fi
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM

reset_statuses() {
    for status_name do
        if ! printf '1\n' > "$scratch/$status_name"; then
            return 1
        fi
    done
}

status_ok() {
    IFS= read -r command_status < "$scratch/$1" && [ "$command_status" = 0 ]
}

is_age_ciphertext() {
    if ! reset_statuses git-head head drain encoder; then
        note_refusal "$path" "cannot initialize staged content prefix statuses."
        return 2
    fi
    # Capture at most 200 bytes as hex, so NUL cannot disappear in a shell
    # variable. Drain the rest instead of closing Git's pipe early. Each
    # producer/helper records its own status; the last pipeline status alone
    # cannot certify the complete index read or the bounded prefix encoding.
    prefix_hex=$(
        { git show ":$path" 2>/dev/null; printf '%s\n' "$?" > "$scratch/git-head"; } |
        { head -c 200; printf '%s\n' "$?" > "$scratch/head";
          cat >/dev/null; printf '%s\n' "$?" > "$scratch/drain"; } |
        { LC_ALL=C od -An -v -tx1; printf '%s\n' "$?" > "$scratch/encoder"; } |
        LC_ALL=C tr -d '[:space:]'
    )
    hex_status=$?
    if [ "$hex_status" -ne 0 ] || ! status_ok git-head || ! status_ok head ||
       ! status_ok drain || ! status_ok encoder; then
        note_refusal "$path" "cannot read or inspect complete staged content prefix."
        return 2
    fi
    case "$prefix_hex" in
        2d2d2d2d2d424547494e2041474520454e435259505445442046494c452d2d2d2d2d*) return 0 ;;
        6167652d656e6372797074696f6e2e6f72672f7631*) return 0 ;;
        *) return 1 ;;
    esac
}

scan_private_key() {
    if ! reset_statuses git-scan; then
        note_refusal "$path" "cannot initialize the staged private-key scan status."
        return
    fi
    # No -q: consume the complete byte stream, including beyond NULs and the
    # prefix, and report grep read errors. Check Git independently afterward.
    { git show ":$path" 2>/dev/null; printf '%s\n' "$?" > "$scratch/git-scan"; } |
        LC_ALL=C grep -a -F -e 'AGE-SECRET-KEY-' >/dev/null 2>&1
    scan_status=$?
    if ! status_ok git-scan; then
        note_refusal "$path" "cannot read complete staged content from the index."
        return
    fi
    case "$scan_status" in
        0) note_refusal "$path" \
            "contains an unwrapped AGE-SECRET-KEY -- that is the fleet master key in plaintext." ;;
        1) ;;
        *) note_refusal "$path" "cannot complete the staged private-key scan." ;;
    esac
}

# Anything staged at all, including renames and copies. Deletions are excluded
# on purpose: `secrets-kit remove` deletes a blob, and there is nothing unsafe
# about removing a file.
#
# Git quotes newline/control/escaped paths even when core.quotePath is false.
# Respect its effective setting for Unicode names. POSIX read preserves
# ordinary complete names, including spaces and glob characters; quoted names
# are explicitly refused because this hook does not decode Git's C escapes.
# The verified enumeration stays in memory. Heredoc expansion does not
# recursively evaluate filename data, and the loop remains in this shell.
if staged=$(git diff --cached --name-only --diff-filter=ACMR); then
if [ -z "$staged" ]; then
    exit 0
fi
while IFS= read -r path; do
    case "$path" in
        \"*)
            note_refusal "$path" "Git-quoted paths are unsupported; refusing without decoding the filename."
            continue
            ;;
    esac

    case "$path" in
        blobs/*.age)
            if ! is_age_ciphertext; then
                note_refusal "$path" \
                    "under blobs/ but is NOT age ciphertext -- this looks like plaintext."
            fi
            ;;
        identity.age)
            if ! is_age_ciphertext; then
                note_refusal "$path" \
                    "the fleet identity is not age ciphertext -- refusing to commit an unwrapped key."
            fi
            ;;
        manifest.json|README.md|.gitignore|.gitattributes)
            ;;
        *)
            note_refusal "$path" \
                "not an allowed path. A fleet-secrets repo holds only manifest.json, identity.age, blobs/*.age, and a README/.gitignore/.gitattributes."
            ;;
    esac

    # Second net, applied to EVERY allowed path too: an unwrapped age private
    # key must never appear anywhere, including inside a file whose path is
    # legitimate. Cheap, and catches the single worst mistake possible here.
    scan_private_key
done <<EOF
$staged
EOF
else
    note_refusal "index" "cannot enumerate complete staged filenames."
fi

if [ "$fail" -ne 0 ]; then
    printf '%s%sfleet-secrets pre-commit guard: REFUSED%s\n\n' "$BOLD" "$RED" "$RESET" >&2
    printf '%s\n' "$refused" >&2
    cat >&2 <<'EOM'
Nothing was committed. Git history is permanent, so this refuses by default
rather than trusting that a file is safe.

If you meant to add a secret, encrypt it instead:

    secrets-kit add <name> --file <plaintext> --dest '<target>'

which encrypts to the fleet public key (no passphrase needed) and stages only
the resulting blobs/<name>.age plus the manifest entry.

If a legitimate non-secret file is being refused, add it to the allowlist in
this hook AND in secrets-kit's canonical copy, so every clone agrees.

Do NOT reach for --no-verify. If plaintext reaches a remote even once, the
remedy is rotating the credential, not deleting the commit.
EOM
    exit 1
fi

exit 0
