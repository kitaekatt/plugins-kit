#!/bin/sh
# secrets-kit-guard-version: 1
#
# Pre-commit guard for a fleet-secrets repo. Refuses any commit that would put
# unencrypted material into history.
#
# This exists because git history is PERMANENT. A plaintext credential pushed
# once cannot be cleanly withdrawn: it survives in the object store, in every
# clone, and in any fork or backup taken meanwhile. Rewriting history does not
# fix it either -- the only real remedy is rotating the leaked credential.
# So the guard is deliberately paranoid, and it is an ALLOWLIST.
#
# Allowlist, not denylist: a denylist has to anticipate every shape a secret
# can take, and loses to the first one it never thought of. This refuses every
# path it does not explicitly recognize, so a new kind of file fails CLOSED --
# the failure mode is an annoyed human, not a leak.
#
# Self-contained on purpose. It is copied into .git/hooks/pre-commit rather
# than sourcing the plugin, because the plugin's cache path contains its
# version and moves on every update -- a hook pointing there would silently
# stop working at the worst possible moment. POSIX sh only, so Git for
# Windows runs it unchanged.
#
# Bypassing this (git commit --no-verify) is not a supported workflow. If a
# legitimate file is being refused, add it to the allowlist here and to the
# canonical copy in secrets-kit, so every clone gets the same rule.

set -u

RED=''
BOLD=''
RESET=''
if [ -t 2 ]; then
    RED=$(printf '\033[31m')
    BOLD=$(printf '\033[1m')
    RESET=$(printf '\033[0m')
fi

fail=0
refused=''

note_refusal() {
    refused="${refused}  - $1
      $2
"
    fail=1
}

# Content of a staged file as it will be COMMITTED (the index), not as it sits
# in the working tree. Checking the worktree would miss the case where a file
# was staged and then edited -- exactly the sleight of hand a guard must not
# fall for.
staged_head() {
    git show ":$1" 2>/dev/null | head -c 200
}

is_age_ciphertext() {
    head_bytes=$(staged_head "$1")
    case "$head_bytes" in
        "-----BEGIN AGE ENCRYPTED FILE-----"*) return 0 ;;
        "age-encryption.org/v1"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Anything staged at all, including renames and copies. Deletions are excluded
# on purpose: `secrets-kit remove` deletes a blob, and there is nothing unsafe
# about removing a file.
#
# The loop below word-splits this list, so a path containing whitespace arrives
# as fragments. That is acceptable BECAUSE the allowlist fails closed: no
# fragment of a whitespace path can satisfy an exact-match case, so it falls to
# the catch-all and the commit is refused. Verified by test. A denylist here
# would fail OPEN on the same input, which is the whole argument for the
# allowlist shape.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
    exit 0
fi

for path in $staged; do
    case "$path" in
        blobs/*.age)
            if ! is_age_ciphertext "$path"; then
                note_refusal "$path" \
                    "under blobs/ but is NOT age ciphertext -- this looks like plaintext."
            fi
            ;;
        identity.age)
            if ! is_age_ciphertext "$path"; then
                note_refusal "$path" \
                    "the fleet identity is not age ciphertext -- refusing to commit an unwrapped key."
            fi
            ;;
        manifest.json|README.md|.gitignore|.gitattributes)
            ;;
        *)
            note_refusal "$path" \
                "not an allowed path. A fleet-secrets repo holds only manifest.json, identity.age, blobs/*.age, and a README/.gitignore/.gitattributes."
            ;;
    esac

    # Second net, applied to EVERY allowed path too: an unwrapped age private
    # key must never appear anywhere, including inside a file whose path is
    # legitimate. Cheap, and catches the single worst mistake possible here.
    if git show ":$path" 2>/dev/null | grep -q 'AGE-SECRET-KEY-'; then
        note_refusal "$path" \
            "contains an unwrapped AGE-SECRET-KEY -- that is the fleet master key in plaintext."
    fi
done

if [ "$fail" -ne 0 ]; then
    printf '%s%sfleet-secrets pre-commit guard: REFUSED%s\n\n' "$BOLD" "$RED" "$RESET" >&2
    printf '%s\n' "$refused" >&2
    cat >&2 <<'EOM'
Nothing was committed. Git history is permanent, so this refuses by default
rather than trusting that a file is safe.

If you meant to add a secret, encrypt it instead:

    secrets-kit add <name> --file <plaintext> --dest '<target>'

which encrypts to the fleet public key (no passphrase needed) and stages only
the resulting blobs/<name>.age plus the manifest entry.

If a legitimate non-secret file is being refused, add it to the allowlist in
this hook AND in secrets-kit's canonical copy, so every clone agrees.

Do NOT reach for --no-verify. If plaintext reaches a remote even once, the
remedy is rotating the credential, not deleting the commit.
EOM
    exit 1
fi

exit 0
