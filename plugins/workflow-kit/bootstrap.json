{
  "$comment": "workflow-kit's openrouter node strategy imports llm_scripting_kit for endpoint, model and key resolution. The edge is declared here so the owning plugin is installed rather than assumed present.",
  "plugins": [
    {
      "ref": "plugins-kit:llm-scripting-kit",
      "enabled": true,
      "scope": "user",
      "install": "auto"
    }
  ],
  "tools": [
    {
      "name": "uv",
      "install": {
        "macos": "curl -LsSf https://astral.sh/uv/install.sh | sh",
        "windows": "powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\"",
        "ubuntu": "curl -LsSf https://astral.sh/uv/install.sh | sh"
      }
    }
  ],
  "venv": {
    "check_imports": [
      "workflow_kit_lib.loader",
      "openai"
    ]
  },
  "shared_lib_imports": [
    "llm_scripting_kit",
    "bootstrap_lib"
  ]
}
