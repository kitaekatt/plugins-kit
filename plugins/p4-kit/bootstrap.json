{
  "requires_bootstrap": "0.21.0",
  "tools": [
    {
      "name": "p4",
      "install": {
        "macos": "brew install --cask perforce",
        "windows": "manual",
        "ubuntu": "manual"
      },
      "download": {
        "windows-amd64": { "scoop": "main/p4" }
      }
    },
    {
      "name": "uv",
      "install": {
        "macos": "curl -LsSf https://astral.sh/uv/install.sh | sh",
        "windows": "powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\"",
        "ubuntu": "curl -LsSf https://astral.sh/uv/install.sh | sh"
      }
    }
  ],
  "venv": {
    "check_imports": []
  },
  "shared_lib_imports": ["bootstrap_lib"],
  "script": {
    "path": "scripts/cleanup_legacy_config.py",
    "entry_point": "cleanup"
  }
}
