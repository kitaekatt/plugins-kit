{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-protocol/1/poll.request.json",
  "title": "poll params",
  "description": "Long-poll for messages to deliver into the session. Request params (strict).",
  "type": "object",
  "properties": {
    "registration_id": {
      "$ref": "#/$defs/registration_id"
    },
    "session_id": {
      "$ref": "#/$defs/session_id"
    },
    "channel_nonce": {
      "$ref": "#/$defs/channel_nonce"
    },
    "wait_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    },
    "max_messages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "required": [
    "registration_id",
    "session_id",
    "channel_nonce",
    "wait_s"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "registration_id": "reg_01JBX3S0A1B2C3D4E5F6G7H8J9",
      "session_id": "7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11",
      "channel_nonce": "c2hhbm5lbC1ub25jZS0wMDAx",
      "wait_s": 25
    },
    {
      "registration_id": "reg_01JBX3S0A1B2C3D4E5F6G7H8J9",
      "session_id": "7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11",
      "channel_nonce": "c2hhbm5lbC1ub25jZS0wMDAx",
      "wait_s": 0,
      "max_messages": 4
    }
  ]
}
