{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-protocol/1/envelope.request.json",
  "title": "Request envelope",
  "description": "POST /v1/<verb> body. params is the verb's <verb>.request schema.",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "id": {
      "$ref": "#/$defs/request_id"
    },
    "verb": {
      "$ref": "#/$defs/verb"
    },
    "origin": {
      "$ref": "#/$defs/identity"
    },
    "params": {
      "type": "object",
      "description": "The verb's request schema (<verb>.request.json)."
    },
    "signed": {
      "$ref": "#/$defs/signed"
    },
    "on_behalf_of": {
      "$ref": "#/$defs/identity",
      "description": "Amendment 2 (katsoft-llm-kit 1.21.0): the direct:<M>/claude/<S> session a relay:<M> origin forwards this call for. Valid only with a relay origin (bad_request otherwise); <M> must be the origin's machine (origin_not_allowed otherwise). A relay without amendment 2 refuses it bad_request."
    }
  },
  "required": [
    "protocol",
    "id",
    "verb",
    "origin",
    "params"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "protocol": "relay-protocol/1",
      "id": "req-0001",
      "verb": "send_message",
      "origin": "direct:m5pro/claude/b91e0c44-2f8a-4d3b-8c6e-71a5d0e3f2a9",
      "params": {
        "to": "m5pro/claude/7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11",
        "kind": "question",
        "body": "Are the relay tests green?",
        "id": "msg_01JBX3V9Q8K2M4N6P7R8S9T0VW",
        "expires_in_s": 3600,
        "task": "plugins-kit/harness-messaging"
      }
    },
    {
      "protocol": "relay-protocol/1",
      "id": "req-0002",
      "verb": "poll",
      "origin": "channel:m5pro/claude/7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11",
      "params": {
        "registration_id": "reg_01JBX3S0A1B2C3D4E5F6G7H8J9",
        "session_id": "7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11",
