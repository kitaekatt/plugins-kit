{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-protocol/1/poll.response.json",
  "title": "poll result",
  "description": "Long-poll for messages to deliver into the session. Response result (unknown fields allowed).",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/delivered_message"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "paused": {
      "type": "boolean"
    },
    "lease_expires_at": {
      "$ref": "#/$defs/epoch"
    }
  },
  "required": [
    "messages",
    "paused",
    "lease_expires_at"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "messages": [
        {
          "id": "msg_01JBX3V9Q8K2M4N6P7R8S9T0VW",
          "sender": "direct:m5pro/claude/b91e0c44-2f8a-4d3b-8c6e-71a5d0e3f2a9",
          "kind": "question",
          "body": "Are the relay tests green?",
          "hop": 0,
          "created_at": 1793664000.0,
          "expires_at": 1793667600.0,
          "attempt": 1,
          "task": "plugins-kit/harness-messaging"
        }
      ],
      "paused": false,
      "lease_expires_at": 1793664090.0
    },
    {
      "messages": [],
      "paused": true,
      "lease_expires_at": 1793664090.0
    }
  ]
}
