#!/usr/bin/env bash
# llm-kit -- shim that invokes the bundled CLI.
#
# Interpreter preference:
#   1. the plugin venv bootstrap provisions -- it carries every extra the CLI
#      reaches (PyYAML, the OpenAI SDK, psutil, the front door's web stack) and
#      the shared-lib link (bootstrap_lib).
#   2. the standalone Python bootstrap installs, only through BOOTSTRAP_PYTHON
#      and only when it resolves inside that install directory.
#   3. anything on PATH.
# The target is bin/llm_kit_entrypoint.py rather than llm_kit.cli directly. It
# adds nothing to sys.path: the library that runs is the katsoft-llm-kit package
# installed in the chosen interpreter's environment (the plugin venv). An
# interpreter that has no katsoft-llm-kit installed fails at the import.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under claudx (CLAUDE_PLUGIN_TEST) the working copy is the plugin under test, so a
# shim running from the plugin cache would run the INSTALLED release. Refuse it.
# Same scope as bootstrap_lib.env_var_check.cache_root_refusal: only the cache of
# CLAUDE_PLUGIN_TEST_MARKETPLACE is refused (every cache path when it is unset).
if [ -n "${CLAUDE_PLUGIN_TEST:-}" ]; then
    _real_root="$(cd "$PLUGIN_ROOT" && pwd -P | tr '[:upper:]' '[:lower:]')"
    _owned="$(printf '%s' "${CLAUDE_PLUGIN_TEST_MARKETPLACE:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$_owned" ]; then
        _needle="/plugins/cache/${_owned}/"
    else
        _needle="/plugins/cache/"
    fi
    case "${_real_root}/" in
        *"$_needle"*)
            echo "llm-kit: refusing to run the cached copy at ${PLUGIN_ROOT}: CLAUDE_PLUGIN_TEST is set, so this session tests the working copy and the cached copy is the INSTALLED release. Run the working copy's bin/llm-kit." >&2
            exit 2
            ;;
    esac
fi
ENTRYPOINT="$PLUGIN_ROOT/bin/llm_kit_entrypoint.py"
DATA_DIR="${HOME}/.claude/plugins/data/plugins-kit/llm-kit"

OS="$(uname -s 2>/dev/null || echo Unknown)"
if [[ "$OS" == MINGW* ]] || [[ "$OS" == MSYS* ]] || [[ "$OS" == CYGWIN* ]]; then
    VENV_REL=".venv/Scripts/python.exe"
else
    VENV_REL=".venv/bin/python"
fi
VENV_PY="${DATA_DIR}/${VENV_REL}"
# CLAUDE_BOOTSTRAP_DATA_ROOT is set only for a session that redirects bootstrap's
# data tree (scripts/claude_plugin_test.py). When it is set, this plugin's venv is
# the one under that tree and nothing else: a missing redirected venv exits 2
# rather than falling back to the production venv, which holds the published
# release and would run it inside a session meant to test the working copy.
# When it is unset the chain below is unchanged.
if [ -n "${CLAUDE_BOOTSTRAP_DATA_ROOT:-}" ]; then
    VENV_PY="${CLAUDE_BOOTSTRAP_DATA_ROOT}/plugins-kit/llm-kit/${VENV_REL}"
    if [ ! -x "$VENV_PY" ]; then
        echo "llm-kit: CLAUDE_BOOTSTRAP_DATA_ROOT redirects bootstrap's data tree, but the redirected plugin interpreter is missing at ${VENV_PY}; refusing to fall back to the production venv." >&2
        exit 2
    fi
fi

if [ -x "$VENV_PY" ]; then
    PY="$VENV_PY"
else
    PY=""
    # BOOTSTRAP_PYTHON counts only when the standalone directory exists and the
    # variable's OWN realpath lies inside it: every symlink is followed first (a
    # relative target against its own directory), then the final directory is
    # resolved physically. An absent standalone directory accepts nothing.
    _standalone="$(cd -P "${HOME}/.local/share/python-standalone" 2>/dev/null && pwd -P)"
    if [ -n "$_standalone" ] && [ -n "${BOOTSTRAP_PYTHON:-}" ] && [ -x "$BOOTSTRAP_PYTHON" ]; then
        # A symlink loop makes the -x test above false (ELOOP), so this loop ends.
        _bp="$BOOTSTRAP_PYTHON"
        while [ -L "$_bp" ]; do
            _target="$(readlink "$_bp")"
            case "$_target" in
                /*) _bp="$_target" ;;
                *) _bp="$(dirname "$_bp")/$_target" ;;
            esac
        done
        case "$(cd -P "$(dirname "$_bp")" 2>/dev/null && pwd -P)/" in
            "$_standalone"/*) PY="$BOOTSTRAP_PYTHON" ;;
        esac
    fi
    if [ -z "$PY" ]; then
        if command -v python3 >/dev/null 2>&1; then
            PY="python3"
        elif command -v python >/dev/null 2>&1; then
            PY="python"
        else
            echo "llm-kit: no Python interpreter found" >&2
            exit 1
        fi
    fi
fi

exec "$PY" "$ENTRYPOINT" "$@"
