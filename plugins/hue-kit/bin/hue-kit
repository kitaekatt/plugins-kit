#!/usr/bin/env bash
# hue-kit -- shim that launches the bundled CLI. The CLI re-execs itself under
# the plugin's bootstrap-provisioned venv (requests/pyyaml/urllib3), so this
# only needs any Python to get started.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under claudx (CLAUDE_PLUGIN_TEST) the working copy is the plugin under test, so a
# shim running from the plugin cache would run the INSTALLED release. Refuse it.
# Same scope as bootstrap_lib.env_var_check.cache_root_refusal: only the cache of
# CLAUDE_PLUGIN_TEST_MARKETPLACE is refused (every cache path when it is unset).
if [ -n "${CLAUDE_PLUGIN_TEST:-}" ]; then
    _real_root="$(cd "$PLUGIN_ROOT" && pwd -P | tr '[:upper:]' '[:lower:]')"
    _owned="$(printf '%s' "${CLAUDE_PLUGIN_TEST_MARKETPLACE:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$_owned" ]; then
        _needle="/plugins/cache/${_owned}/"
    else
        _needle="/plugins/cache/"
    fi
    case "${_real_root}/" in
        *"$_needle"*)
            echo "hue-kit: refusing to run the cached copy at ${PLUGIN_ROOT}: CLAUDE_PLUGIN_TEST is set, so this session tests the working copy and the cached copy is the INSTALLED release. Run the working copy's bin/hue-kit." >&2
            exit 2
            ;;
    esac
fi
CLI="$PLUGIN_ROOT/scripts/hue_kit_cli.py"

# Prefer the standalone Python bootstrap installs; the CLI re-execs into the
# plugin venv itself, so this launcher just needs any working interpreter.
OS="$(uname -s 2>/dev/null || echo Unknown)"
if [[ "$OS" == MINGW* ]] || [[ "$OS" == MSYS* ]] || [[ "$OS" == CYGWIN* ]]; then
    PY="${HOME}/.local/share/python-standalone/python/python.exe"
else
    PY="${HOME}/.local/share/python-standalone/python/bin/python3"
fi

# BOOTSTRAP_PYTHON counts only when the standalone directory exists and the
# variable's OWN realpath lies inside it: every symlink is followed first (a
# relative target against its own directory), then the final directory is
# resolved physically. An absent standalone directory accepts nothing.
if [ ! -x "$PY" ]; then
    _standalone="$(cd -P "${HOME}/.local/share/python-standalone" 2>/dev/null && pwd -P)"
    if [ -n "$_standalone" ] && [ -n "${BOOTSTRAP_PYTHON:-}" ] && [ -x "$BOOTSTRAP_PYTHON" ]; then
        # A symlink loop makes the -x test above false (ELOOP), so this loop ends.
        _bp="$BOOTSTRAP_PYTHON"
        while [ -L "$_bp" ]; do
            _target="$(readlink "$_bp")"
            case "$_target" in
                /*) _bp="$_target" ;;
                *) _bp="$(dirname "$_bp")/$_target" ;;
            esac
        done
        case "$(cd -P "$(dirname "$_bp")" 2>/dev/null && pwd -P)/" in
            "$_standalone"/*) PY="$BOOTSTRAP_PYTHON" ;;
        esac
    fi
fi

if [ ! -x "$PY" ]; then
    if command -v python3 >/dev/null 2>&1; then
        PY="python3"
    elif command -v python >/dev/null 2>&1; then
        PY="python"
    else
        echo "hue-kit: no Python interpreter found" >&2
        exit 1
    fi
fi

exec "$PY" "$CLI" "$@"
