{
  "$comment": "requires_bootstrap is the call shape this plugin needs: shipped skill text launches scripts as \"${BOOTSTRAP_PYTHON:?requires bootstrap >= 0.120.0}\", which only bootstrap 0.120.0's SessionStart hook exports.",
  "requires_bootstrap": "0.120.0",
  "tools": [
    {
      "name": "uv",
      "install": {
        "macos": "curl -LsSf https://astral.sh/uv/install.sh | sh",
        "windows": "powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\"",
        "ubuntu": "curl -LsSf https://astral.sh/uv/install.sh | sh"
      }
    }
  ],
  "venv": {
    "check_imports": ["requests", "yaml", "urllib3", "zeroconf"]
  },
  "script": {
    "path": "custom_bootstrap.py",
    "entry_point": "bootstrap"
  }
}
